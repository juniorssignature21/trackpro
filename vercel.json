{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index-2.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index-2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/track.php",
      "destination": "/track",
      "permanent": true
    },
    {
      "source": "/track.html",
      "destination": "/track",
      "permanent": true
    },
    {
      "source": "/quote.php",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/quote.html",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/receipt.php",
      "destination": "/receipt",
      "permanent": true
    },
    {
      "source": "/receipt.html",
      "destination": "/receipt",
      "permanent": true
    },
    {
      "source": "/services.php",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/business.php",
      "destination": "/business",
      "permanent": true
    },
    {
      "source": "/business.html",
      "destination": "/business",
      "permanent": true
    },
    {
      "source": "/about.php",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/help.php",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/help.html",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/contact.php",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/business",
      "destination": "/business/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/help",
      "destination": "/help/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/quote",
      "destination": "/quote/index.html"
    },
    {
      "source": "/track",
      "destination": "/track/index.html"
    },
    {
      "source": "/receipt",
      "destination": "/receipt/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(admin|book)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
