# Backend URL, no trailing slash. Leave empty in dev (Vite proxies /api to :8000).
# On Vercel set it in Project → Settings → Environment Variables, e.g. https://trackpro-api.vercel.app
VITE_API_URL=

# Public site URL (no trailing slash) used for canonical URLs, sitemap.xml and social previews.
VITE_SITE_URL=https://vdcexpresslogistics.com
